{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "monster.raw.schema.json",
   "title": "Raw Monster",
   "type": "object",
   "additionalProperties": false,
   "required": [
      "slug",
      "name",
      "dlc",
      "role",
      "speed",
      "tame_rate_pct",
      "max_level",
      "growth",
      "stats",
      "feral_link",
      "locations",
      "constellations",
      "affinities",
      "abilities"
   ],
   "properties": {
      "source_url": {
         "type": "string"
      },
      "source_id": {
         "type": [
            "integer",
            "null"
         ],
         "minimum": 1
      },
      "monster_image": {
         "type": [
            "string",
            "null"
         ]
      },
      "slug": {
         "type": "string",
         "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
         "type": "string",
         "minLength": 1
      },
      "dlc": {
         "type": "boolean"
      },
      "role": {
         "type": "string",
         "enum": [
            "Commando",
            "Ravager",
            "Sentinel",
            "Saboteur",
            "Synergist",
            "Medic"
         ]
      },
      "speed": {
         "type": [
            "integer",
            "null"
         ],
         "minimum": 0
      },
      "tame_rate_pct": {
         "type": [
            "number",
            "null"
         ],
         "minimum": 0,
         "maximum": 100
      },
      "max_level": {
         "type": [
            "integer",
            "null"
         ],
         "minimum": 1
      },
      "growth": {
         "type": [
            "string",
            "null"
         ],
         "enum": [
            "Early Peaker",
            "Late Bloomer",
            "Standard",
            "Well-grown",
            null
         ]
      },
      "special_notes": {
         "type": [
            "string",
            "null"
         ]
      },
      "paradigm_pack_notes": {
         "type": [
            "string",
            "null"
         ]
      },
      "stats": {
         "type": "object",
         "additionalProperties": false,
         "required": [
            "hp_min",
            "hp_max",
            "str_min",
            "str_max",
            "mag_min",
            "mag_max"
         ],
         "properties": {
            "hp_min": {
               "type": [
                  "integer",
                  "null"
               ],
               "minimum": 0
            },
            "hp_max": {
               "type": [
                  "integer",
                  "null"
               ],
               "minimum": 0
            },
            "str_min": {
               "type": [
                  "integer",
                  "null"
               ],
               "minimum": 0
            },
            "str_max": {
               "type": [
                  "integer",
                  "null"
               ],
               "minimum": 0
            },
            "mag_min": {
               "type": [
                  "integer",
                  "null"
               ],
               "minimum": 0
            },
            "mag_max": {
               "type": [
                  "integer",
                  "null"
               ],
               "minimum": 0
            }
         }
      },
      "feral_link": {
         "type": [
            "object",
            "null"
         ],
         "additionalProperties": false,
         "required": [
            "name",
            "description",
            "type",
            "damage_modifier",
            "charge_time_seconds",
            "effects",
            "combos"
         ],
         "properties": {
            "name": {
               "type": [
                  "string",
                  "null"
               ]
            },
            "description": {
               "type": [
                  "string",
                  "null"
               ]
            },
            "type": {
               "type": [
                  "string",
                  "null"
               ],
               "enum": [
                  "Physical",
                  "Magic",
                  "Recovery",
                  "Buff",
                  "Debuff",
                  "Other",
                  null
               ]
            },
            "damage_modifier": {
               "type": [
                  "number",
                  "null"
               ],
               "minimum": 0
            },
            "charge_time_seconds": {
               "type": [
                  "integer",
                  "null"
               ],
               "minimum": 0
            },
            "effects": {
               "type": "array",
               "items": {
                  "type": "string"
               }
            },
            "combos": {
               "type": "object",
               "additionalProperties": false,
               "required": [
                  "ps3",
                  "xbox"
               ],
               "properties": {
                  "ps3": {
                     "type": "array",
                     "items": {
                        "type": "string"
                     }
                  },
                  "xbox": {
                     "type": "array",
                     "items": {
                        "type": "string"
                     }
                  }
               }
            }
         }
      },
      "locations": {
         "type": "array",
         "items": {
            "$ref": "#/$defs/namedReference"
         },
         "uniqueItems": true
      },
      "constellations": {
         "type": "array",
         "items": {
            "$ref": "#/$defs/namedReference"
         },
         "uniqueItems": true
      },
      "affinities": {
         "type": "object",
         "additionalProperties": false,
         "required": [
            "weak",
            "halved",
            "resistant",
            "immune"
         ],
         "properties": {
            "weak": {
               "$ref": "#/$defs/stringArray"
            },
            "halved": {
               "$ref": "#/$defs/stringArray"
            },
            "resistant": {
               "$ref": "#/$defs/stringArray"
            },
            "immune": {
               "$ref": "#/$defs/stringArray"
            }
         }
      },
      "abilities": {
         "type": "object",
         "additionalProperties": false,
         "required": [
            "passives",
            "skills"
         ],
         "properties": {
            "passives": {
               "type": "array",
               "items": {
                  "$ref": "#/$defs/rawPassiveEntry"
               }
            },
            "skills": {
               "type": "array",
               "items": {
                  "$ref": "#/$defs/rawSkillEntry"
               }
            }
         }
      }
   },
   "$defs": {
      "namedReference": {
         "type": "object",
         "additionalProperties": false,
         "required": [
            "name"
         ],
         "properties": {
            "name": {
               "type": "string",
               "minLength": 1
            },
            "slug": {
               "type": [
                  "string",
                  "null"
               ],
               "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "source_url": {
               "type": [
                  "string",
                  "null"
               ]
            }
         }
      },
      "stringArray": {
         "type": "array",
         "items": {
            "type": "string"
         },
         "uniqueItems": true
      },
      "rawPassiveEntry": {
         "type": "object",
         "additionalProperties": false,
         "required": [
            "name",
            "level",
            "default",
            "red_locked"
         ],
         "properties": {
            "name": {
               "type": "string",
               "minLength": 1
            },
            "slug": {
               "type": [
                  "string",
                  "null"
               ],
               "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "source_url": {
               "type": [
                  "string",
                  "null"
               ]
            },
            "level": {
               "type": [
                  "integer",
                  "null"
               ],
               "minimum": 1
            },
            "default": {
               "type": "boolean"
            },
            "red_locked": {
               "type": "boolean"
            }
         }
      },
      "rawSkillEntry": {
         "type": "object",
         "additionalProperties": false,
         "required": [
            "name",
            "level",
            "default",
            "infusable"
         ],
         "properties": {
            "name": {
               "type": "string",
               "minLength": 1
            },
            "slug": {
               "type": [
                  "string",
                  "null"
               ],
               "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "source_url": {
               "type": [
                  "string",
                  "null"
               ]
            },
            "level": {
               "type": [
                  "integer",
                  "null"
               ],
               "minimum": 1
            },
            "default": {
               "type": "boolean"
            },
            "infusable": {
               "type": "boolean"
            }
         }
      }
   }
}
